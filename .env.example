# =========================
# Cloudinary
# =========================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =========================
# Database (SQLite)
# =========================
# Path to the SQLite database file (relative to process.cwd()), or :memory:
SQLITE_DB_PATH=./data/app.sqlite
# In non-production, TypeORM synchronize updates the schema from entities.
# SQLITE_DEBUG=true

# =========================
# Server
# =========================
PORT=3000
NODE_ENV=development
